# Hindsight Cloud
# Use a real Hindsight API key and bank to enable persistent cloud memory.
HINDSIGHT_API_KEY=your_hindsight_api_key
HINDSIGHT_BANK_ID=your_bank_id
HINDSIGHT_API_BASE=https://api.hindsight.vectorize.io

# App
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
VITE_API_URL=http://localhost:8000

# Demo fallback. Set false when Hindsight credentials are configured.
DEMO_MODE=true
